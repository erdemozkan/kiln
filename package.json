{
  "name": "kiln",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "npm run dev -w @kiln/playground",
    "build:playground": "npm run build -w @kiln/playground",
    "build:package": "npm run build -w kiln-webgpu"
  },
  "devDependencies": {
    "@webgpu/types": "0.1.40",
    "typescript": "5.4.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
